# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev-run logs (backend.log, frontend.log, etc. — never meant to be committed)
*.log

# Playwright / test run artifacts
/test-results/
/playwright-report/

# env files (can opt-in for committing if needed)
.env*
.env.local
# ...except the documented templates, which have no secrets and should be committed
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
