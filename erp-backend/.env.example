# erp-backend environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- App ---
NODE_ENV=development
# NestJS listens on 3001 (see src/main.ts); global API prefix is /api

# Comma-separated list of allowed frontend origins for CORS. Unset, defaults
# to http://localhost:3000 (Next.js' default dev port) only. Set this
# explicitly in every non-local environment.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Database ---
# Preferred: a full connection string (Supabase Postgres or any Postgres instance)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# Set to "true" when connecting to Supabase or any provider that requires SSL
DB_SSL=true

# Alternative: discrete Postgres connection vars, used only if DATABASE_URL is not set
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=erp

# Local/offline fallback (no external DB needed) — set DB_TYPE=sqlite to use this instead
# DB_TYPE=sqlite
# DB_DATABASE=data/sqlite.db

# --- Auth ---
# Required. Use a long random string in every real environment.
JWT_SECRET=replace-with-a-long-random-secret
# Optional, defaults to 1d for the access token (see auth.module.ts).
# Note: auth.service.ts currently signs access tokens with its own 15m expiry
# regardless of this value for the login/refresh flow — see AuthService.
JWT_EXPIRES_IN=1d
